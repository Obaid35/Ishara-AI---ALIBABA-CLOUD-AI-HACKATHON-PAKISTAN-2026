# Local development only — never commit this file.
# Copy to .env and fill in real values.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=psl_bridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/psl_bridge

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Initial admin account (seed only, must change password on first login) ---
SEED_ADMIN_EMAIL=admin@pslbridge.local
SEED_ADMIN_PASSWORD=change_me

# --- Speech ---
KOKORO_VOICE=
KOKORO_LANG=h

# --- Doctor STT (P1, optional; demo runs without it) ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
LOCAL_STT_MODEL=small
LOCAL_STT_COMPUTE=int8
